<Project>

  <!--
    MSBuild stops at the first Directory.Build.props it finds walking up from a project,
    and does not chain them. Nothing sits above this file today, so this import is a no-op
    — but without it, a props file added later at the repo root or at services/api/ would be
    silently ignored by exactly these four projects. Silent misconfiguration is the failure
    this directory exists to prevent, so the door is closed here rather than in a comment
    asking someone to remember.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"
          Condition="'$([MSBuild]::GetPathOfFileAbove(&quot;Directory.Build.props&quot;, &quot;$(MSBuildThisFileDirectory)../&quot;))' != ''" />

  <!--
    The floor every production project inherits. The analyzer is wired here and not in
    any .csproj on purpose: a ProjectReference in a project file is five lines of XML
    anyone can delete to switch off every rule at once, and a guard that blocks .csproj
    edits is a guard that gets disabled by lunchtime. There is nothing here to delete
    that does not show up in a diff as what it is. See ADR 0009.

    Test projects under services/api/tests/ sit outside this directory and are not
    analyzed: a fixture swapping a real DbContext for an in-memory one is not a
    layering violation.
  -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\tools\analyzers\Jig.Analyzers\Jig.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\..\..\tools\analyzers\Jig.Analyzers\ArchLayers.txt" />
  </ItemGroup>

</Project>
