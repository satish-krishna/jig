using FastEndpoints;
using FluentValidation;

namespace <%- m.product %>.Api.<%- m.pascalPlural %>;

/// <summary>Request-shape validation for <%- m.opPrefix %>.save. Runs before the handler; a failure
/// returns 400 with the field errors. Business rules (uniqueness) live in <%- m.pascal %>Service.</summary>
public sealed class Save<%- m.pascal %>Validator : Validator<Save<%- m.pascal %>Request>
{
    public Save<%- m.pascal %>Validator()
    {
<%_ for (const rule of m.rules) { _%>
        RuleFor(x => x.<%- rule.property %>).NotEmpty()<%- rule.suffix %>;
<%_ } _%>
    }
}
