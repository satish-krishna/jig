use serde::{Deserialize, Serialize};
use std::collections::HashMap;
use std::sync::Mutex;
use uuid::Uuid;

/// The <%- m.noun %> shape crossing the wire. Serializes to the same JSON as the .NET
/// <%- m.pascal %>Response, so the operation registry's res type fits both.
#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct <%- m.pascal %> {
    pub id: String,
<%_ for (const field of m.fields) { _%>
    pub <%- field.snake %>: <%- field.rustType %>,
